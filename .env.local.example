# .env.local — Business OS Environment Variables
# Copy this to .env.local and fill in your values

# ============================================================
# SUPABASE (required)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================
# OPENROUTER (required for AI features)
# Get free key at: https://openrouter.ai/keys
# Free models used: qwen/qwen3-coder:free, deepseek/deepseek-r1:free
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# APP URL
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to: https://your-app.vercel.app

# ============================================================
# STRIPE (optional — for invoice payments)
# ============================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
